# Copy to .env for `docker compose up`. These values are for a local machine only.
POSTGRES_PASSWORD=replace-with-a-local-password
# At least 32 characters. Generate one with: openssl rand -base64 48
CLOUDOPS_JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
# The account registered with this email becomes the first administrator.
CLOUDOPS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
